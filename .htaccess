# ==============================================================================
# VETE - CONFIGURACIÓN HOSTINGER (LiteSpeed / Apache Web Server)
# ==============================================================================

# 1. FORZAR HTTPS AUTOMÁTICO
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. TIPOS MIME PARA PWA, FUENTES Y CÓDIGOS
<IfModule mod_mime.c>
  AddType application/manifest+json .json .webmanifest
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg .svgz
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
  AddType font/woff2 .woff2
</IfModule>

# 3. POLÍTICAS DE CACHÉ
<IfModule mod_headers.c>
  # Service Worker y Manifest: NUNCA en caché para permitir actualizaciones instantáneas
  <FilesMatch "^(sw\.js|manifest\.json)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # HTML principal: Validación rápida
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Archivos estáticos: Caché agresiva para máxima velocidad en planta/móvil
  <FilesMatch "\.(css|js|png|jpg|jpeg|svg|gif|ico|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  # Cabeceras de Seguridad
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. COMPRESIÓN GZIP / BROTLI (Carga ultra rápida en galpón)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# 5. SOPORTE SPA Y SEGURIDAD CONTRA ACCESO A ARCHIVOS SENSIBLES
<FilesMatch "^\.(env|git|htaccess)">
  Order allow,deny
  Deny from all
</FilesMatch>

Options -Indexes
DirectoryIndex index.html
